#!/bin/sh
set -e

case "$1" in
  configure)
    ln -sf "/opt/ads-generator/bin/ADS Generator" /usr/bin/ads-generator

    install -D -m 0644 "/opt/ads-generator/lib/ADS Generator.png" \
      /usr/share/icons/hicolor/128x128/apps/es-jcprieto-ADSGenerator.png || true

    install -D -m 0644 /dev/stdin /usr/share/applications/es-jcprieto-ADSGenerator.desktop <<'EOF'
[Desktop Entry]
Name=ADS Generator
Comment=Asistente para crear guias ADS
Exec="/opt/ads-generator/bin/ADS Generator"
Icon=es-jcprieto-ADSGenerator
Terminal=false
Type=Application
Categories=Development;
StartupWMClass=es-jcprieto-ADSGenerator
StartupNotify=true
EOF

    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q || true
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q /usr/share/icons/hicolor || true
  ;;
esac

exit 0
